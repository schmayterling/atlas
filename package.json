    "graphology": "^0.25.4",
    "graphology-traversal": "^0.3.1",
    "graphology-shortest-path": "^2.1.0",
    "graphology-dag": "^0.4.1",
    "graphology-types": "^0.24.7",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.4",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "tree-sitter-javascript"

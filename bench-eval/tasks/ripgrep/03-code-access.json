{
	"id": "ripgrep-03-code-access",
	"capability": "code-access",
	"intent": "which file contains the top-level `run` function?",
	"atlas_method": "symbolDetail",
	"atlas_args": { "q": "crates/core/main.rs::run" },
	"expected": {
		"type": "symbol-set",
		"symbols": ["crates/core/main.rs::run"]
	},
	"comparable_to_text_search": true,
	"text_search_strategy": {
		"mode": "rg-files-with-matches",
		"pattern": "^fn run\\(result:",
		"glob": "*.rs"
	}
}

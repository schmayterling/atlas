{
	"id": "ripgrep-09-code-access",
	"capability": "code-access",
	"intent": "which file contains the `print_stats` helper?",
	"atlas_method": "symbolDetail",
	"atlas_args": { "q": "crates/core/main.rs::print_stats" },
	"expected": {
		"type": "symbol-set",
		"symbols": ["crates/core/main.rs::print_stats"]
	},
	"comparable_to_text_search": true,
	"text_search_strategy": {
		"mode": "rg-files-with-matches",
		"pattern": "^fn print_stats",
		"glob": "*.rs"
	}
}

{
	"id": "unleash-08-discovery",
	"capability": "discovery",
	"intent": "find the ForbiddenError class definition",
	"atlas_method": "search",
	"atlas_args": {
		"q": "ForbiddenError",
		"kind": "class",
		"limit": 10
	},
	"expected": {
		"type": "symbol-set",
		"symbols": [
			"frontend/src/utils/apiUtils.ts::ForbiddenError"
		]
	},
	"comparable_to_text_search": true,
	"text_search_strategy": {
		"mode": "rg-symbols",
		"pattern": "^\\s*class\\s+(ForbiddenError)\\b",
		"glob": "*.ts",
		"capture": 1
	}
}

{
	"id": "pydantic-13-text-content",
	"capability": "text-content",
	"intent": "how many python files mention \"Field\" in their content?",
	"atlas_method": "searchContent",
	"atlas_args": {
		"q": "Field",
		"language": "python",
		"maxMatches": 1000
	},
	"expected": {
		"type": "count",
		"value": 116,
		"tolerance": 8
	},
	"comparable_to_text_search": true,
	"text_search_strategy": {
		"mode": "rg-files-with-matches",
		"pattern": "Field",
		"glob": "**/*.py"
	}
}
